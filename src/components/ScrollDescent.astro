---
import manifest from '../../public/media/descent/manifest.json';
import { asset, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Where the final call to action leads. */
  href: string;
}

const { locale, href } = Astro.props;
const ui = t(locale).descent;

/**
 * Text layers pinned to the progress of the descent (0 is the top step, 1 the
 * bottom). Each layer fades in and out inside its own window.
 */
const layers = [
  { in: 0.0, out: 0.24, kind: 'brand' },
  { in: 0.26, out: 0.5, kind: 'invocation' },
  { in: 0.52, out: 0.74, kind: 'years' },
  { in: 0.76, out: 1.0, kind: 'saga' },
] as const;
---

<section class="descent" data-descent data-count={manifest.count} aria-label={ui.aria}>
  <div class="descent__track">
    <div class="descent__viewport">
      <canvas class="descent__canvas" data-canvas aria-hidden="true"></canvas>

      <img
        class="descent__poster"
        src={asset("/media/descent/poster.webp")}
        alt={ui.posterAlt}
        width="1600"
        height="890"
        data-poster
      />

      <div class="descent__scrim" aria-hidden="true"></div>

      <div class="descent__loader" data-loader>
        <span class="descent__flame" aria-hidden="true"></span>
        <p class="descent__loading eyebrow">{ui.loader}</p>
        <div class="descent__bar"><i data-bar></i></div>
      </div>

      <div class="descent__stage">
        {
          layers.map((layer) => (
            <div class="layer" data-layer data-in={layer.in} data-out={layer.out}>
              {layer.kind === 'brand' && (
                <>
                  <p class="layer__greek wordmark">EREBOR</p>
                  <h1 class="display layer__title">
                    {ui.titleLine1}
                    <br />
                    {ui.titleLine2}
                  </h1>
                  <p class="layer__sub">{ui.subtitle}</p>
                </>
              )}

              {layer.kind === 'invocation' && (
                <blockquote class="layer__quote">
                  <p>
                    {ui.invocation[0]}
                    <br />
                    {ui.invocation[1]}
                    <br />
                    {ui.invocation[2]}
                  </p>
                  <cite>{ui.invocationCite}</cite>
                </blockquote>
              )}

              {layer.kind === 'years' && (
                <>
                  <p class="layer__count">
                    <span>10</span> {ui.warYears}
                    <br />
                    <span>10</span> {ui.roadYears}
                  </p>
                  <p class="layer__sub">{ui.fleet}</p>
                </>
              )}

              {layer.kind === 'saga' && (
                <>
                  <p class="eyebrow">{ui.sagaFirst}</p>
                  <p class="layer__greek greek layer__greek--big">ΟΔΥΣΣΕΙΑ</p>
                  <h2 class="display layer__title">{t(locale).nav.odyssey}</h2>
                  <a class="descent__cta" href={href}>
                    <span>{ui.cta}</span>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                      <path
                        d="M12 3v18m0 0l-7-7m7 7l7-7"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                    </svg>
                  </a>
                </>
              )}
            </div>
          ))
        }
      </div>

      <div class="descent__cue" data-cue aria-hidden="true">
        <span>{ui.cue}</span>
        <i></i>
      </div>
    </div>
  </div>
</section>

<style>
  .descent {
    position: relative;
    background: #000;
  }

  /* Five screens of scrolling for 121 frames — roughly a frame every 4px. */
  .descent__track {
    height: 520svh;
  }

  .descent__viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .descent__canvas,
  .descent__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .descent__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .descent.is-ready .descent__canvas {
    opacity: 1;
  }

  .descent__poster {
    filter: saturate(0.9);
  }

  .descent.is-ready .descent__poster {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .descent__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 70% at 50% 55%, transparent 20%, rgba(4, 3, 6, 0.72) 100%),
      linear-gradient(180deg, rgba(4, 3, 6, 0.7) 0%, transparent 26%, transparent 62%, rgba(4, 3, 6, 0.86) 100%);
  }

  /* ── Preloader ──────────────────────────────────────────── */

  .descent__loader {
    position: absolute;
    inset: auto 0 clamp(3rem, 10vh, 6rem);
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    transition: opacity 0.8s var(--ease-out);
  }

  .descent.is-ready .descent__loader {
    opacity: 0;
    pointer-events: none;
  }

  .descent__flame {
    width: 7px;
    height: 14px;
    border-radius: 50% 50% 45% 45%;
    background: linear-gradient(180deg, var(--flame), var(--terra));
    box-shadow: 0 0 18px 4px color-mix(in srgb, var(--flame) 55%, transparent);
    animation: flicker 1.4s ease-in-out infinite;
  }

  @keyframes flicker {
    0%, 100% { transform: scaleY(1) translateY(0); opacity: 1; }
    35% { transform: scaleY(1.28) translateY(-2px); opacity: 0.86; }
    70% { transform: scaleY(0.86) translateY(1px); opacity: 0.95; }
  }

  .descent__loading {
    margin: 0;
    color: var(--bone-dim);
  }

  .descent__bar {
    width: min(46vw, 15rem);
    height: 1px;
    background: color-mix(in srgb, var(--bone) 14%, transparent);
    overflow: hidden;
  }

  .descent__bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold-deep), var(--flame));
    transition: width 0.4s var(--ease);
  }

  /* ── Text layers ────────────────────────────────────────── */

  .descent__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .layer {
    grid-area: 1 / 1;
    max-width: 46rem;
    opacity: 0;
    will-change: opacity, transform;
  }

  .layer > * + * {
    margin-top: 1.15rem;
  }

  .layer__greek {
    font-size: clamp(0.85rem, 0.7rem + 0.6vw, 1.1rem);
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--gold);
    margin: 0;
  }

  .layer__greek--big {
    font-size: clamp(1rem, 0.7rem + 1.2vw, 1.5rem);
  }

  .layer__title {
    font-size: var(--step-4);
    color: var(--bone);
    text-shadow: 0 0.15em 1.4em rgba(0, 0, 0, 0.85);
  }

  .layer__sub {
    margin: 0;
    color: var(--bone-dim);
    font-size: var(--step-0);
    font-style: italic;
  }

  .layer__quote {
    margin: 0;
  }

  .layer__quote p {
    margin: 0 0 1.4rem;
    font-size: var(--step-1);
    line-height: 1.72;
    color: var(--bone);
    font-style: italic;
    text-shadow: 0 0.15em 1.4em rgba(0, 0, 0, 0.85);
  }

  .layer__quote cite {
    font-family: var(--font-micro);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }

  :lang(ar) .layer__quote cite {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.8rem;
  }

  .layer__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.24;
    color: var(--bone);
  }

  .layer__count span {
    color: var(--gold);
    font-size: 1.5em;
    line-height: 1;
  }

  .descent__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding: 0.95rem 2.1rem;
    border: 1px solid var(--rule);
    color: var(--gold);
    font-family: var(--font-micro);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--void) 55%, transparent);
    backdrop-filter: blur(6px);
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  :lang(ar) .descent__cta {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.9rem;
  }

  .descent__cta:hover {
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    border-color: var(--gold);
    color: var(--bone);
  }

  /* ── Scroll cue ─────────────────────────────────────────── */

  .descent__cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    font-family: var(--font-micro);
    font-size: 0.6rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--bone-faint);
    transition: opacity 0.6s var(--ease);
  }

  :lang(ar) .descent__cue {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.75rem;
  }

  .descent__cue i {
    display: block;
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(180deg, var(--gold), transparent);
    animation: cue-drop 2.4s var(--ease) infinite;
    transform-origin: top;
  }

  @keyframes cue-drop {
    0% { transform: scaleY(0); opacity: 0; }
    40% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(1.5rem); opacity: 0; }
  }

  .descent.is-scrolled .descent__cue {
    opacity: 0;
  }

  /* ── prefers-reduced-motion ─────────────────────────────── */

  .descent.is-static .descent__track {
    height: auto;
  }

  .descent.is-static .descent__viewport {
    position: relative;
    height: auto;
    min-height: 100svh;
  }

  .descent.is-static .descent__canvas,
  .descent.is-static .descent__loader,
  .descent.is-static .descent__cue {
    display: none;
  }

  .descent.is-static .descent__poster {
    opacity: 1;
  }

  .descent.is-static .layer {
    opacity: 1;
    grid-area: auto;
  }

  /* Without animation the layers become ordinary flow and set the height. */
  .descent.is-static .descent__stage {
    position: relative;
    inset: auto;
    display: grid;
    gap: clamp(3rem, 8vh, 5rem);
    align-content: start;
    padding-block: clamp(6rem, 16vh, 10rem);
  }
</style>

<script>
  type Frames = (HTMLImageElement | undefined)[];

  const section = document.querySelector<HTMLElement>('[data-descent]');

  if (section) {
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const track = section.querySelector<HTMLElement>('.descent__track')!;
    const bar = section.querySelector<HTMLElement>('[data-bar]')!;
    const layerEls = [...section.querySelectorAll<HTMLElement>('[data-layer]')];
    const count = Number(section.dataset.count ?? 0);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced || count === 0) {
      section.classList.add('is-static');
    } else {
      const ctx = canvas.getContext('2d', { alpha: false })!;

      // Narrow screens and data-saver mode get the lighter frame set.
      const saveData =
        (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
          ?.saveData === true;
      const dir = window.innerWidth < 900 || saveData ? 'w720' : 'w1280';

      const frames: Frames = new Array(count);
      let loadedCount = 0;
      /** The descent becomes interactive before every frame has arrived. */
      const UNLOCK_AT = Math.min(24, count);
      let unlocked = false;

      const src = (i: number) =>
        `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/media/descent/${dir}/${String(i).padStart(3, '0')}.webp`;

      function loadFrame(i: number): Promise<void> {
        return new Promise((resolve) => {
          const img = new Image();
          img.decoding = 'async';
          img.onload = () => {
            frames[i] = img;
            loadedCount++;
            bar.style.width = `${Math.round((loadedCount / count) * 100)}%`;
            if (!unlocked && loadedCount >= UNLOCK_AT) unlock();
            resolve();
          };
          img.onerror = () => {
            loadedCount++;
            resolve();
          };
          img.src = src(i);
        });
      }

      function unlock() {
        unlocked = true;
        section.classList.add('is-ready');
        resize();
        render(true);
      }

      // Loaded sequentially with a little concurrency: the early frames land
      // first, so the descent opens quickly.
      async function preload() {
        const queue = [...Array(count).keys()];
        const workers = Array.from({ length: 6 }, async () => {
          for (let i = queue.shift(); i !== undefined; i = queue.shift()) {
            await loadFrame(i);
          }
        });
        await Promise.all(workers);
        if (!unlocked) unlock();
      }

      /** Nearest frame already in memory, so the canvas is never blank. */
      function nearestLoaded(i: number): HTMLImageElement | undefined {
        if (frames[i]) return frames[i];
        for (let d = 1; d < count; d++) {
          if (frames[i - d]) return frames[i - d];
          if (frames[i + d]) return frames[i + d];
        }
        return undefined;
      }

      function resize() {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        const w = section.clientWidth;
        const h = window.innerHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function drawCover(img: HTMLImageElement) {
        const w = canvas.width / Math.min(devicePixelRatio || 1, 2);
        const h = canvas.height / Math.min(devicePixelRatio || 1, 2);
        const scale = Math.max(w / img.naturalWidth, h / img.naturalHeight);
        const dw = img.naturalWidth * scale;
        const dh = img.naturalHeight * scale;
        ctx.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
      }

      /** Progress of the descent: 0 is the first step, 1 the bottom. */
      function progress() {
        const rect = track.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        if (total <= 0) return 0;
        return Math.min(1, Math.max(0, -rect.top / total));
      }

      let shown = 0;
      let target = 0;
      let ticking = false;
      let inView = true;

      function paintLayers(p: number) {
        for (const el of layerEls) {
          const from = Number(el.dataset.in);
          const to = Number(el.dataset.out);
          const t = (p - from) / (to - from);

          // A trapezoid: in over the first quarter of the window, out over the
          // last. The outer edge of the first and last layer is never faded —
          // otherwise the title would be missing at the very top of the page
          // and the call to action at the bottom of the descent.
          const fadeIn = from <= 0.001 ? 0 : 0.25;
          const fadeOut = to >= 0.999 ? 0 : 0.25;

          let opacity = 0;
          if (t >= 0 && t <= 1) {
            const rising = fadeIn ? Math.min(1, t / fadeIn) : 1;
            const falling = fadeOut ? Math.min(1, (1 - t) / fadeOut) : 1;
            opacity = Math.min(rising, falling);
          }

          el.style.opacity = String(opacity);
          el.style.transform = `translateY(${(0.5 - Math.min(1, Math.max(0, t))) * 36}px)`;
          el.style.pointerEvents = opacity > 0.6 ? 'auto' : 'none';
        }
      }

      function render(instant = false) {
        const p = progress();
        target = p * (count - 1);

        if (instant) {
          shown = target;
        } else {
          // A little lag makes the motion read as film rather than as steps.
          shown += (target - shown) * 0.18;
          if (Math.abs(target - shown) < 0.02) shown = target;
        }

        const img = nearestLoaded(Math.round(shown));
        if (img) drawCover(img);

        paintLayers(p);
        section.classList.toggle('is-scrolled', p > 0.03);
      }

      function loop() {
        render();
        if (inView && Math.abs(target - shown) > 0.02) {
          requestAnimationFrame(loop);
        } else {
          ticking = false;
        }
      }

      function schedule() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(loop);
      }

      addEventListener('scroll', schedule, { passive: true });
      addEventListener(
        'resize',
        () => {
          resize();
          render(true);
        },
        { passive: true }
      );

      // No animation frames are spent while the section is off screen.
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          if (inView) schedule();
        },
        { threshold: 0 }
      ).observe(track);

      resize();
      paintLayers(progress());
      preload();
    }
  }
</script>
