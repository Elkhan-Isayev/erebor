---
import { anchorPath, localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();
const home = localePath(locale, '/');
---

<footer class="footer">
  <div class="wrap">
    <div class="ornament" aria-hidden="true"><span></span></div>

    <div class="footer__grid">
      <div>
        <p class="footer__mark wordmark">EREBOR</p>
        <p class="footer__name">{ui.footer.name}</p>
        <p class="footer__note">{ui.footer.note}</p>
      </div>

      <nav class="footer__nav" aria-label={ui.footerNavAria}>
        <a href={home}>{ui.nav.home}</a>
        <a href={anchorPath(locale, 'sagas')}>{ui.nav.sagas}</a>
        <a href={localePath(locale, '/sagas/odysseia')}>{ui.nav.odyssey}</a>
        <a href={anchorPath(locale, 'about')}>{ui.nav.about}</a>
      </nav>
    </div>

    <p class="footer__legal">
      © {year} EREBOR. {ui.quoteCredit} {ui.footer.legal}
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3rem);
    background: var(--void);
    border-top: 1px solid var(--rule-soft);
  }

  .footer__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    margin-block: clamp(2.5rem, 6vw, 4rem) clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 46rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .footer__mark {
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
  }

  .footer__name {
    margin: 0 0 1rem;
    max-width: 30rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--bone-faint);
  }

  .footer__note {
    margin: 0;
    max-width: 30rem;
    color: var(--bone-dim);
    font-size: var(--step--1);
  }

  .footer__nav {
    display: grid;
    gap: 0.7rem;
    font-family: var(--font-micro);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  :lang(ar) .footer__nav {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.85rem;
  }

  .footer__nav a {
    color: var(--bone-dim);
    transition: color 0.35s var(--ease);
  }

  .footer__nav a:hover {
    color: var(--gold);
  }

  .footer__legal {
    margin: 0;
    font-family: var(--font-micro);
    font-size: 0.68rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--bone-faint);
    max-width: 52rem;
  }
</style>
