---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { anchorPath, localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  path: string;
  transparent?: boolean;
}

const { locale, path, transparent = false } = Astro.props;
const ui = t(locale);
const home = localePath(locale, '/');

const links = [
  { href: anchorPath(locale, 'sagas'), label: ui.nav.sagas, match: null },
  { href: localePath(locale, '/sagas/odysseia'), label: ui.nav.odyssey, match: '/sagas/odysseia' },
  { href: anchorPath(locale, 'about'), label: ui.nav.about, match: null },
];
---

<header class:list={['header', { 'header--floating': transparent }]} data-header>
  <div class="header__inner">
    <a href={home} class="brand" aria-label={ui.brandHome}>
      <svg class="brand__mark" viewBox="0 0 26 20" width="21" height="16" aria-hidden="true">
        <path d="M1.5 19 L10 3 L14.5 10.5 L17.5 6.5 L24.5 19 Z" />
      </svg>
      <span class="brand__name wordmark">EREBOR</span>
    </a>

    <div class="header__end">
      <nav class="nav" aria-label={ui.navAria}>
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={['nav__link', { 'is-current': link.match === path }]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <LanguageSwitcher locale={locale} path={path} />
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    background: color-mix(in srgb, var(--void) 82%, transparent);
    backdrop-filter: blur(14px) saturate(0.9);
    border-bottom: 1px solid var(--rule-soft);
    transition:
      background 0.6s var(--ease),
      border-color 0.6s var(--ease),
      backdrop-filter 0.6s var(--ease);
  }

  /* Over a hero the header stays invisible until the page starts scrolling. */
  .header--floating:not(.is-solid) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  .header__inner {
    width: min(100% - var(--gutter) * 2, var(--page));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(0.85rem, 1.6vw, 1.25rem);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  /* The Lonely Mountain — the mark the name comes from. */
  .brand__mark {
    flex: none;
    fill: var(--gold);
    transition: fill 0.4s var(--ease);
  }

  .brand__name {
    font-size: 0.94rem;
    color: var(--bone);
    transition: color 0.4s var(--ease);
  }

  .brand:hover .brand__name {
    color: var(--gold);
  }

  .brand:hover .brand__mark {
    fill: var(--flame);
  }

  .nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  .nav__link {
    font-family: var(--font-micro);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone-dim);
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  :lang(ar) .nav__link {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.82rem;
  }

  .nav__link:hover,
  .nav__link.is-current {
    color: var(--gold);
    border-bottom-color: var(--rule);
  }

  @media (max-width: 46rem) {
    .brand__name {
      display: none;
    }

    .nav__link {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
    }
  }

  @media (max-width: 30rem) {
    .nav {
      gap: 0.75rem;
    }
  }
</style>
