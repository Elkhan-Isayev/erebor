---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

// The control; the sound itself is synthesised in src/scripts/kithara.ts.

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<button
  class="lyre"
  data-lyre
  type="button"
  aria-pressed="false"
  aria-label={ui.music.turnOn}
  data-label={ui.music.label}
  data-on={ui.music.turnOff}
  data-off={ui.music.turnOn}
>
  <svg class="lyre__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M6.5 20C3.5 16 3.5 9 6.5 4.5" />
    <path d="M17.5 20c3-4 3-11 0-15.5" />
    <path d="M6.5 6.5h11" />
    <g class="lyre__strings">
      <line x1="9.5" y1="6.5" x2="9.5" y2="19" />
      <line x1="12" y1="6.5" x2="12" y2="19.8" />
      <line x1="14.5" y1="6.5" x2="14.5" y2="19" />
    </g>
  </svg>
  <span class="lyre__label" data-lyre-label>{ui.music.label}</span>
</button>

<style>
  .lyre {
    position: fixed;
    inset-inline-end: var(--gutter);
    inset-block-end: clamp(1.25rem, 3vh, 2rem);
    z-index: 88;

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;

    border: 1px solid var(--rule-soft);
    background: color-mix(in srgb, var(--void) 78%, transparent);
    backdrop-filter: blur(10px);
    color: var(--bone-faint);

    font-family: var(--font-micro);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;

    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      background 0.4s var(--ease);
  }

  :lang(ar) .lyre {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.75rem;
  }

  .lyre:hover {
    color: var(--bone-dim);
    border-color: var(--rule);
  }

  .lyre[aria-pressed='true'] {
    color: var(--gold);
    border-color: var(--rule);
  }

  .lyre__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    flex: none;
  }

  .lyre__strings line {
    transform-origin: center;
  }

  /* The strings tremble while the kithara is sounding. */
  .lyre[aria-pressed='true'] .lyre__strings line:nth-child(1) {
    animation: string 1.9s ease-in-out infinite;
  }

  .lyre[aria-pressed='true'] .lyre__strings line:nth-child(2) {
    animation: string 2.6s ease-in-out infinite 0.3s;
  }

  .lyre[aria-pressed='true'] .lyre__strings line:nth-child(3) {
    animation: string 2.2s ease-in-out infinite 0.7s;
  }

  @keyframes string {
    0%, 100% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(1.9); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lyre__strings line {
      animation: none !important;
    }
  }

  @media (max-width: 32rem) {
    .lyre__label {
      display: none;
    }

    .lyre {
      padding: 0.65rem;
    }
  }
</style>

<script>
  import { Kithara, type Genus, type Mood } from '../scripts/kithara';

  const button = document.querySelector<HTMLButtonElement>('[data-lyre]');
  const label = document.querySelector<HTMLElement>('[data-lyre-label]');

  if (button && label) {
    const STORAGE = 'erebor:kithara';
    const text = {
      idle: button.dataset.label ?? 'Kithara',
      on: button.dataset.on ?? '',
      off: button.dataset.off ?? '',
    };

    const kithara = new Kithara();
    let pending: Mood | null = null;
    let place: string | null = null;

    function paint(on: boolean) {
      button!.setAttribute('aria-pressed', String(on));
      button!.setAttribute('aria-label', on ? text.on : text.off);
      label!.textContent = on && place ? place : text.idle;
    }

    async function enable() {
      await kithara.start(0.6);
      if (pending) kithara.setMood(pending);
      localStorage.setItem(STORAGE, 'on');
      paint(true);
    }

    function disable() {
      kithara.stop();
      localStorage.setItem(STORAGE, 'off');
      paint(false);
    }

    button.addEventListener('click', () => {
      if (kithara.playing) disable();
      else void enable();
    });

    // The mode changes together with the station.
    document.addEventListener('station:enter', (event) => {
      const detail = (event as CustomEvent).detail as {
        genus: Genus;
        tonic: number;
        gap: number;
        name: string;
      };

      pending = { genus: detail.genus, tonic: detail.tonic, gap: detail.gap };
      place = detail.name;
      kithara.setMood(pending);
      if (kithara.playing) paint(true);
    });

    // Browsers refuse to start audio without a gesture, so a saved preference
    // is honoured on the first interaction with the page instead.
    if (localStorage.getItem(STORAGE) === 'on') {
      const resume = () => {
        void enable();
        removeEventListener('pointerdown', resume);
        removeEventListener('keydown', resume);
      };
      addEventListener('pointerdown', resume, { once: true });
      addEventListener('keydown', resume, { once: true });
    }

    // Leaving the tab silences the instrument.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && kithara.playing) kithara.stop();
    });

    paint(false);
  }
</script>
