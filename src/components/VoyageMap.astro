---
import type { Locale } from '../i18n/config';
import { PLACES, type PlaceKey } from '../i18n/places';
import { t } from '../i18n/ui';

/**
 * The voyage of Odysseus — the background layer of the saga.
 *
 * Fixed to the viewport underneath the content: the station scenes cover it,
 * the text panels are translucent, so the chart stays visible while reading.
 * The ship advances exactly in step with the stations — its position along the
 * course is interpolated between landfalls using where the stations actually
 * sit on the page.
 *
 * Coastlines are schematic, in the spirit of a portolan chart. Landfalls use
 * the traditional identifications (Polyphemus on Sicily, Circe at Cape
 * Circeo, Calypso on Gozo). Homer ties almost none of them to real geography,
 * which the caption says outright.
 */

type Pt = [lon: number, lat: number];

interface Props {
  locale: Locale;
  /** Selector of the stations container that drives the progress. */
  target: string;
}

const { locale, target } = Astro.props;
const ui = t(locale);
const place = PLACES[locale];

const BOUNDS = { lonMin: 8, lonMax: 30, latMin: 30, latMax: 45 };
const W = 1160;
const H = 1000;

const project = ([lon, lat]: Pt): [number, number] => [
  ((lon - BOUNDS.lonMin) / (BOUNDS.lonMax - BOUNDS.lonMin)) * W,
  ((BOUNDS.latMax - lat) / (BOUNDS.latMax - BOUNDS.latMin)) * H,
];

const round = (n: number) => Math.round(n * 10) / 10;

function land(points: Pt[]): string {
  return (
    points
      .map(project)
      .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${round(x)} ${round(y)}`)
      .join(' ') + ' Z'
  );
}

/** Smoothed course line: Catmull-Rom converted to cubic Béziers. */
function course(points: Pt[]): string {
  const p = points.map(project);
  if (p.length < 2) return '';

  let d = `M${round(p[0][0])} ${round(p[0][1])}`;

  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] ?? p[i];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[i + 2] ?? p2;

    d += ` C${round(p1[0] + (p2[0] - p0[0]) / 6)} ${round(p1[1] + (p2[1] - p0[1]) / 6)},`;
    d += ` ${round(p2[0] - (p3[0] - p1[0]) / 6)} ${round(p2[1] - (p3[1] - p1[1]) / 6)},`;
    d += ` ${round(p2[0])} ${round(p2[1])}`;
  }
  return d;
}

const LANDMASSES: Pt[][] = [
  // Italian peninsula
  [
    [7.6, 43.8], [9.9, 44.1], [10.3, 43.0], [11.2, 42.4], [12.3, 41.7],
    [13.1, 41.2], [14.0, 40.8], [14.9, 40.2], [15.8, 39.9], [16.1, 39.4],
    [15.9, 38.9], [15.65, 38.1], [16.1, 37.95], [16.6, 38.5], [17.2, 38.9],
    [17.15, 39.4], [16.5, 39.8], [17.2, 40.5], [18.0, 40.1], [18.5, 40.15],
    [18.4, 40.6], [17.9, 41.0], [16.9, 41.1], [16.2, 41.4], [15.9, 41.6],
    [16.2, 41.9], [15.0, 42.0], [14.1, 42.4], [13.5, 43.6], [12.4, 44.2],
    [12.5, 45.4], [10.5, 45.6], [8.5, 45.4],
  ],
  // Sicily
  [
    [12.45, 37.8], [13.4, 38.2], [14.4, 38.1], [15.25, 38.25], [15.3, 37.5],
    [15.1, 36.8], [14.5, 36.7], [13.2, 37.1],
  ],
  // Sardinia
  [[8.2, 41.2], [9.6, 41.2], [9.8, 40.5], [9.7, 39.2], [8.9, 38.9], [8.4, 39.2], [8.4, 40.6]],
  // Corsica
  [[8.6, 42.9], [9.5, 42.8], [9.55, 41.9], [9.2, 41.4], [8.8, 41.6], [8.6, 42.4]],
  // The Balkans and mainland Greece
  [
    [19.3, 42.6], [19.45, 41.8], [19.5, 40.6], [20.2, 39.6], [20.75, 39.0],
    [21.15, 38.4], [22.2, 38.4], [23.0, 38.4], [23.7, 38.2], [24.05, 37.65],
    [23.9, 38.3], [23.6, 39.0], [22.9, 39.2], [22.6, 40.0], [23.0, 40.4],
    [24.0, 40.5], [25.0, 40.9], [26.2, 40.9], [26.3, 41.7], [24.5, 41.5],
    [22.5, 42.0], [20.5, 42.5],
  ],
  // The Peloponnese
  [
    [21.15, 38.25], [22.2, 38.25], [22.85, 38.0], [23.15, 37.6], [23.4, 37.45],
    [23.2, 37.0], [23.2, 36.45], [22.95, 36.8], [22.6, 36.8], [22.5, 37.2],
    [22.2, 36.85], [21.95, 36.9], [21.7, 37.35], [21.6, 37.8], [21.35, 38.05],
  ],
  // Crete
  [[23.55, 35.5], [24.7, 35.6], [25.8, 35.4], [26.3, 35.3], [26.0, 35.0], [24.8, 35.0], [23.6, 35.2]],
  // Asia Minor
  [
    [26.2, 40.4], [27.0, 40.6], [28.5, 40.9], [30.0, 41.0], [30.0, 36.3],
    [29.3, 36.2], [28.2, 36.6], [27.4, 37.0], [27.2, 37.6], [26.4, 38.2],
    [26.9, 38.4], [26.7, 38.9], [26.1, 39.5], [26.2, 40.0],
  ],
  // North Africa
  [
    [8.0, 36.9], [9.8, 37.3], [10.3, 37.1], [11.0, 37.1], [11.1, 36.8],
    [10.6, 35.9], [11.0, 35.6], [11.1, 35.2], [10.6, 34.5], [10.1, 34.3],
    [10.5, 33.8], [11.0, 33.5], [11.5, 33.2], [13.2, 32.9], [15.2, 32.4],
    [17.0, 31.0], [18.5, 30.5], [20.0, 32.0], [21.5, 32.9], [23.0, 32.6],
    [25.0, 31.6], [27.0, 31.3], [29.0, 31.0], [30.0, 31.2], [30.0, 30.0],
    [8.0, 30.0],
  ],
];

/** The course. Points with an anchor are stations; the rest shape the line. */
const COURSE: { at: Pt; numeral?: string; key?: PlaceKey; anchor?: string }[] = [
  { at: [26.24, 39.96], numeral: 'I', key: 'troy', anchor: 'troy' },
  { at: [25.6, 40.6] },
  { at: [24.5, 39.4] },
  { at: [23.9, 37.6] },
  { at: [23.2, 36.35], key: 'malea' },
  { at: [21.0, 35.5] },
  { at: [17.5, 34.2] },
  { at: [14.0, 33.9] },
  { at: [10.9, 33.8], numeral: 'II', key: 'lotus', anchor: 'lotus' },
  { at: [11.6, 35.2] },
  { at: [12.9, 36.7] },
  { at: [15.45, 37.6], numeral: 'III', key: 'polyphemus', anchor: 'polyphemus' },
  { at: [14.95, 38.6], numeral: 'IV', key: 'aiolos', anchor: 'aiolos' },
  { at: [13.6, 39.9] },
  { at: [13.1, 41.15], numeral: 'V', key: 'circe', anchor: 'circe' },
  { at: [10.6, 42.0], numeral: 'VI', key: 'hades', anchor: 'hades' },
  { at: [12.4, 41.2] },
  { at: [14.45, 40.5], numeral: 'VII', key: 'sirens', anchor: 'sirens' },
  { at: [15.62, 38.2], numeral: 'VIII', key: 'scylla', anchor: 'scylla' },
  { at: [14.9, 36.9], key: 'thrinacia' },
  { at: [14.3, 35.9], numeral: 'IX', key: 'calypso', anchor: 'calypso' },
  { at: [17.5, 37.2] },
  { at: [19.85, 39.5], key: 'phaeacians' },
  { at: [20.72, 38.4], numeral: 'X', key: 'ithaca', anchor: 'ithaca' },
];

/** The bag of winds was opened in sight of Ithaca — and the storm threw them back. */
const NEAR_MISS: Pt[] = [
  [14.95, 38.6], [17.2, 38.75], [19.6, 38.5], [20.5, 38.4], [19.4, 39.0], [17.0, 39.1], [14.95, 38.6],
];

/** Hades lies past the edge of Ocean: the course runs west and breaks off. */
const BEYOND: Pt[] = [[10.6, 42.0], [9.2, 42.3], [8.05, 42.5]];

const coursePath = course(COURSE.map((p) => p.at));
const marks = COURSE.filter((p) => p.key).map((p) => {
  const [x, y] = project(p.at);
  return { ...p, x: round(x), y: round(y), label: place[p.key!] };
});
---

<div class="voyage" data-voyage data-target={target} role="img" aria-label={ui.map.aria}>
  <svg class="voyage__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="voyage-wake" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#8c6f34" />
        <stop offset="100%" stop-color="#ff9440" />
      </linearGradient>
    </defs>

    <g class="voyage__grid">
      {[1, 2, 3, 4].map((i) => <line x1="0" x2={W} y1={(H / 5) * i} y2={(H / 5) * i} />)}
      {[1, 2, 3, 4, 5, 6].map((i) => <line y1="0" y2={H} x1={(W / 7) * i} x2={(W / 7) * i} />)}
    </g>

    <g class="voyage__land">
      {LANDMASSES.map((mass) => <path d={land(mass)} />)}
    </g>

    <path class="voyage__beyond" d={course(BEYOND)} />
    <path class="voyage__nearmiss" d={course(NEAR_MISS)} />

    <path class="voyage__course voyage__course--ghost" d={coursePath} />
    <path class="voyage__course voyage__course--live" d={coursePath} data-course />

    <g class="voyage__marks">
      {
        marks.map((m) => (
          <g
            class:list={['mark', { 'mark--minor': !m.numeral }]}
            data-mark
            data-x={m.x}
            data-y={m.y}
            data-anchor={m.anchor}
          >
            <circle class="mark__halo" cx={m.x} cy={m.y} r="16" />
            <circle class="mark__dot" cx={m.x} cy={m.y} r={m.numeral ? 5 : 3.2} />
            <text class="mark__label" x={m.x + 13} y={m.y + 5}>
              {m.numeral ? `${m.numeral}. ${m.label}` : m.label}
            </text>
          </g>
        ))
      }
    </g>

    <g class="voyage__ship" data-ship>
      <circle class="ship__glow" r="17" />
      <path class="ship__hull" d="M-9 3 Q0 9 9 3 Q0 6 -9 3 Z M0 3 L0 -9 M0 -9 L7 -5 L0 -2" />
    </g>
  </svg>

</div>

<style>
  .voyage {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    padding: clamp(3.5rem, 9vh, 6rem) var(--gutter) clamp(2.5rem, 7vh, 4rem);
    background:
      radial-gradient(ellipse 80% 70% at 50% 50%, #0d1620 0%, #070a10 70%),
      var(--void);
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s var(--ease);
  }

  .voyage.is-visible {
    opacity: 1;
  }

  .voyage__svg {
    width: 100%;
    height: 100%;
  }

  /* ── Chart ──────────────────────────────────────────────── */

  .voyage__grid line {
    stroke: color-mix(in srgb, var(--gold) 7%, transparent);
    stroke-width: 1;
  }

  .voyage__land path {
    fill: #171922;
    stroke: color-mix(in srgb, var(--gold) 46%, transparent);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .voyage__course {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .voyage__course--ghost {
    stroke: color-mix(in srgb, var(--bone) 9%, transparent);
    stroke-width: 2;
    stroke-dasharray: 3 7;
  }

  .voyage__course--live {
    stroke: url(#voyage-wake);
    stroke-width: 3.4;
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--flame) 50%, transparent));
  }

  .voyage__nearmiss,
  .voyage__beyond {
    fill: none;
    stroke: color-mix(in srgb, var(--terra) 40%, transparent);
    stroke-width: 1.6;
    stroke-dasharray: 6 8;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }

  .voyage.show-nearmiss .voyage__nearmiss,
  .voyage.show-beyond .voyage__beyond {
    opacity: 1;
  }

  /* ── Landfalls ──────────────────────────────────────────── */

  .mark__halo {
    fill: color-mix(in srgb, var(--flame) 20%, transparent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    scale: 0.4;
    transition:
      opacity 0.6s var(--ease),
      scale 0.6s var(--ease-out);
  }

  .mark__dot {
    fill: #0a0c12;
    stroke: color-mix(in srgb, var(--gold) 42%, transparent);
    stroke-width: 1.6;
    transition:
      fill 0.5s var(--ease),
      stroke 0.5s var(--ease);
  }

  .mark__label {
    fill: color-mix(in srgb, var(--bone-faint) 92%, transparent);
    font-family: var(--font-serif);
    font-size: 21px;
    letter-spacing: 0.05em;
    paint-order: stroke;
    stroke: rgba(5, 7, 12, 0.85);
    stroke-width: 3px;
    transition: fill 0.5s var(--ease);
  }

  .mark--minor .mark__label {
    font-size: 17px;
    font-style: italic;
  }

  .mark.is-passed .mark__dot {
    fill: var(--gold);
    stroke: var(--gold);
  }

  .mark.is-passed .mark__label {
    fill: var(--bone-dim);
  }

  .mark.is-current .mark__halo {
    opacity: 1;
    scale: 1;
  }

  .mark.is-current .mark__dot {
    fill: var(--flame);
    stroke: var(--flame);
  }

  .mark.is-current .mark__label {
    fill: var(--bone);
  }

  /* ── Ship ───────────────────────────────────────────────── */

  .voyage__ship {
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }

  .voyage.is-sailing .voyage__ship {
    opacity: 1;
  }

  .ship__glow {
    fill: color-mix(in srgb, var(--flame) 34%, transparent);
    animation: ship-pulse 3.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes ship-pulse {
    0%, 100% { opacity: 0.75; scale: 1; }
    50% { opacity: 1; scale: 1.22; }
  }

  .ship__hull {
    fill: none;
    stroke: var(--bone);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.9));
  }

  @media (prefers-reduced-motion: reduce) {
    .ship__glow {
      animation: none;
    }
  }

  @media (max-width: 46rem) {
    .mark__label {
      font-size: 28px;
    }

    .mark--minor .mark__label {
      font-size: 22px;
    }

  }
</style>

<script>
  const layer = document.querySelector<HTMLElement>('[data-voyage]');
  const container = layer ? document.querySelector<HTMLElement>(layer.dataset.target!) : null;

  if (layer && container) {
    const path = layer.querySelector<SVGPathElement>('[data-course]')!;
    const ship = layer.querySelector<SVGGElement>('[data-ship]')!;
    const marks = [...layer.querySelectorAll<SVGGElement>('[data-mark]')];
    const stations = [...container.querySelectorAll<HTMLElement>('[data-station]')];

    const total = path.getTotalLength();
    path.style.strokeDasharray = String(total);

    const SAMPLES = 3000;
    const samples: { x: number; y: number; len: number }[] = [];
    for (let i = 0; i <= SAMPLES; i++) {
      const len = (i / SAMPLES) * total;
      const p = path.getPointAtLength(len);
      samples.push({ x: p.x, y: p.y, len });
    }

    // The course crosses itself: off Sicily the line passes twice, and the
    // return leg runs almost through Polyphemus. So every landfall is searched
    // for only ahead of the previous one — otherwise it snaps to the later leg.
    let cursor = 0;

    const stops = marks.map((mark) => {
      const x = Number(mark.dataset.x);
      const y = Number(mark.dataset.y);

      let best = cursor;
      let bestD = Infinity;

      for (const s of samples) {
        if (s.len < cursor) continue;
        const d = (s.x - x) ** 2 + (s.y - y) ** 2;
        if (d < bestD) {
          bestD = d;
          best = s.len;
        }
      }
      cursor = best;

      return { mark, len: best, anchor: mark.dataset.anchor };
    });

    // Page stations in route order, each with its point on the course.
    const legs = stations
      .map((el) => {
        const stop = stops.find((s) => s.anchor === el.id);
        return stop ? { el, len: stop.len } : null;
      })
      .filter((l): l is { el: HTMLElement; len: number } => l !== null);

    /** The ship's position is tied to where the stations actually sit. */
    function travelled(): number {
      if (!legs.length) return 0;

      const eye = window.scrollY + window.innerHeight * 0.5;
      const top = (el: HTMLElement) => el.getBoundingClientRect().top + window.scrollY;

      if (eye <= top(legs[0].el)) return 0;

      for (let i = 0; i < legs.length - 1; i++) {
        const a = top(legs[i].el);
        const b = top(legs[i + 1].el);
        if (eye < b) {
          const t = b > a ? (eye - a) / (b - a) : 0;
          return legs[i].len + (legs[i + 1].len - legs[i].len) * t;
        }
      }
      return total;
    }

    function draw() {
      const len = travelled();
      path.style.strokeDashoffset = String(total - len);

      const point = path.getPointAtLength(len);
      const ahead = path.getPointAtLength(Math.min(total, len + 4));
      const angle = (Math.atan2(ahead.y - point.y, ahead.x - point.x) * 180) / Math.PI + 90;
      ship.setAttribute('transform', `translate(${point.x} ${point.y}) rotate(${angle})`);

      let current = stops[0];
      for (const stop of stops) {
        const passed = len >= stop.len - 2;
        stop.mark.classList.toggle('is-passed', passed);
        if (passed) current = stop;
      }
      for (const stop of stops) {
        stop.mark.classList.toggle('is-current', stop === current);
      }

      const p = len / total;
      layer.classList.toggle('is-sailing', p > 0.004);
      layer.classList.toggle('show-nearmiss', p > 0.42);
      layer.classList.toggle('show-beyond', p > 0.56);
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        draw();
        ticking = false;
      });
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });

    // The chart only shows while the stations are on screen.
    new IntersectionObserver(
      ([entry]) => layer.classList.toggle('is-visible', entry.isIntersecting),
      { threshold: 0 }
    ).observe(container);

    draw();
  }
</script>
